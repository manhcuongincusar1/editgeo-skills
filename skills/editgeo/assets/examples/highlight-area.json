{
  "version": 1,
  "output": { "width": 1080, "height": 1920, "fps": 30, "duration": 6, "ss": 1.5 },
  "basemap": {
    "styleTemplate": "satellite",
    "vars": { "tiles": "{maptiler}" },
    "projection": "mercator"
  },
  "assets": {
    "parcel1": {
      "id": "parcel1",
      "type": "geojson",
      "name": "Property parcel boundary",
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": { "name": "Lot 42" },
            "geometry": {
              "type": "Polygon",
              "coordinates": [[
                [106.6998, 10.7775],
                [106.7020, 10.7775],
                [106.7020, 10.7762],
                [106.6998, 10.7762],
                [106.6998, 10.7775]
              ]]
            }
          }
        ]
      }
    }
  },
  "drawingOptions": {
    "parcelFill": {
      "id": "parcelFill",
      "name": "Yellow highlight fill + stroke",
      "fill": { "addFill": true, "fillColor": { "r": 255, "g": 210, "b": 40, "a": 1 }, "opacity": 0.35 },
      "stroke": { "addStroke": true, "strokeColor": { "r": 255, "g": 210, "b": 40, "a": 1 }, "strokeWidth": 3 }
    }
  },
  "slots": [
    {
      "id": "cam",
      "type": "viewport",
      "items": [
        { "time": 0, "interpolator": "flyTo", "easer": "inOutQuad",
          "value": { "lng": 106.7009, "lat": 10.7769, "zoom": 16.8, "bearing": 0, "pitch": 0 } }
      ]
    },
    {
      "id": "parcel",
      "type": "geojson",
      "dataAssetId": "parcel1",
      "drawingOptionId": "parcelFill",
      "items": [
        { "time": 0.5, "transitionIn": 1, "easer": "inOutQuad",
          "value": { "opacity": 1, "autoTransitionOpacity": true },
          "animators": [ { "name": "highlight-pulse", "effectors": [ { "type": "sin", "propName": "opacity", "amp": 0.25, "dur": 1.6 } ] } ] }
      ]
    },
    {
      "id": "label",
      "type": "marker",
      "items": [
        { "time": 1.2, "transitionIn": 0.6, "easer": "inOutQuad",
          "value": { "text": "Lot 42 — 320 m²", "lng": 106.7009, "lat": 10.7769, "autoTransitionOpacity": true } }
      ]
    }
  ]
}
