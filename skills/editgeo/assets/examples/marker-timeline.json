{
  "version": 1,
  "output": { "width": 1920, "height": 1080, "fps": 30, "duration": 10, "ss": 1.5 },
  "basemap": {
    "styleTemplate": "satellite",
    "vars": { "tiles": "{maptiler}" },
    "projection": "mercator"
  },
  "markerTemplates": {
    "event": {
      "id": "event",
      "name": "History event pin",
      "font": "Verdana",
      "fontSize": 22,
      "textColor": { "r": 255, "g": 255, "b": 255, "a": 1 },
      "backgroundColor": { "r": 20, "g": 30, "b": 60, "a": 0.85 }
    }
  },
  "slots": [
    {
      "id": "cam",
      "type": "viewport",
      "items": [
        { "time": 0, "interpolator": "flyTo", "easer": "inOutQuad",
          "value": { "lng": 106.7006, "lat": 10.7759, "zoom": 14.6, "bearing": 0, "pitch": 30 } }
      ]
    },
    {
      "id": "events",
      "type": "marker",
      "name": "Sequential history markers",
      "items": [
        { "time": 1, "duration": 8.5, "transitionIn": 0.6, "transitionOut": 0.6, "easer": "inOutQuad",
          "value": { "markerTemplateId": "event", "text": "1698 — Founding of Saigon", "lng": 106.6953, "lat": 10.7765, "autoTransitionOpacity": true, "autoTransitionScale": true },
          "animators": [ { "name": "pop", "effectors": [ { "type": "sin", "propName": "scale", "amp": 0.06, "dur": 2 } ] } ] },
        { "time": 3.5, "duration": 6, "transitionIn": 0.6, "transitionOut": 0.6, "easer": "inOutQuad",
          "value": { "markerTemplateId": "event", "text": "1859 — French citadel", "lng": 106.7009, "lat": 10.7769, "autoTransitionOpacity": true } },
        { "time": 6, "duration": 3.5, "transitionIn": 0.6, "transitionOut": 0.6, "easer": "inOutQuad",
          "value": { "markerTemplateId": "event", "text": "1975 — Reunification", "lng": 106.7045, "lat": 10.7745, "autoTransitionOpacity": true } }
      ]
    }
  ]
}
